{
  "name": "@boardpilot/sprint-service",
  "version": "1.0.0",
  "description": "Sprint Service for BoardPilot AI — manages sprints, velocity, and burndown",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@boardpilot/common": "file:../../shared/packages/common",
    "@boardpilot/errors": "file:../../shared/packages/errors",
    "@boardpilot/events": "file:../../shared/packages/events",
    "@boardpilot/logger": "file:../../shared/packages/logger",
    "@boardpilot/middlewares": "file:../../shared/packages/middlewares",
    "@boardpilot/types": "file:../../shared/packages/types",
    "@prisma/client": "^5.8.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "prisma": "^5.8.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "testMatch": ["**/*.test.ts"],
    "moduleNameMapper": {
      "^@boardpilot/types$": "<rootDir>/../../shared/packages/types/src/index.ts",
      "^@boardpilot/errors$": "<rootDir>/../../shared/packages/errors/src/index.ts",
      "^@boardpilot/common$": "<rootDir>/../../shared/packages/common/src/index.ts",
      "^@boardpilot/logger$": "<rootDir>/../../shared/packages/logger/src/index.ts",
      "^@boardpilot/events$": "<rootDir>/../../shared/packages/events/src/index.ts",
      "^@boardpilot/middlewares$": "<rootDir>/../../shared/packages/middlewares/src/index.ts"
    },
    "coverageDirectory": "coverage",
    "collectCoverageFrom": ["src/**/*.ts", "!src/index.ts"]
  }
}
