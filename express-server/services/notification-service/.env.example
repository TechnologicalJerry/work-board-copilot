# Service
NODE_ENV=development
PORT=3010
SERVICE_NAME=notification-service
LOG_LEVEL=info

# JWT
JWT_ACCESS_SECRET=your-super-secret-access-key-minimum-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-minimum-32-chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here!

# MongoDB (In-App Notifications)
MONGODB_URI=mongodb://localhost:27017/boardpilot_notifications

# PostgreSQL (Templates & Webhooks)
DATABASE_URL=postgresql://postgres:password@localhost:5432/boardpilot_notifications

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# SMTP (Email Channel)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=noreply@boardpilot.io
SMTP_PASSWORD=your-smtp-password
EMAIL_FROM=BoardPilot <noreply@boardpilot.io>

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# CORS
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
