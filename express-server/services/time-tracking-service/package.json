{
  "name": "@boardpilot/time-tracking-service",
  "version": "1.0.0",
  "description": "Time Tracking microservice for BoardPilot AI",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@boardpilot/common": "file:../../shared/packages/common",
    "@boardpilot/config": "file:../../shared/packages/config",
    "@boardpilot/errors": "file:../../shared/packages/errors",
    "@boardpilot/events": "file:../../shared/packages/events",
    "@boardpilot/logger": "file:../../shared/packages/logger",
    "@boardpilot/middlewares": "file:../../shared/packages/middlewares",
    "@boardpilot/types": "file:../../shared/packages/types",
    "@boardpilot/validation": "file:../../shared/packages/validation",
    "@prisma/client": "^5.10.2",
    "amqplib": "^0.10.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "node-cron": "^3.0.3",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.30",
    "@types/node-cron": "^3.0.11",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.8",
    "@types/yamljs": "^0.2.34",
    "jest": "^29.7.0",
    "prisma": "^5.10.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "testMatch": ["**/*.test.ts"],
    "moduleNameMapper": {
      "@boardpilot/types": "<rootDir>/../../shared/packages/types/src/index.ts",
      "@boardpilot/errors": "<rootDir>/../../shared/packages/errors/src/index.ts",
      "@boardpilot/common": "<rootDir>/../../shared/packages/common/src/index.ts",
      "@boardpilot/logger": "<rootDir>/../../shared/packages/logger/src/index.ts",
      "@boardpilot/middlewares": "<rootDir>/../../shared/packages/middlewares/src/index.ts",
      "@boardpilot/events": "<rootDir>/../../shared/packages/events/src/index.ts",
      "@boardpilot/validation": "<rootDir>/../../shared/packages/validation/src/index.ts",
      "@boardpilot/config": "<rootDir>/../../shared/packages/config/src/index.ts"
    },
    "collectCoverageFrom": ["src/**/*.ts", "!src/server.ts"],
    "coverageDirectory": "coverage"
  }
}
