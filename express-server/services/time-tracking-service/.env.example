# Application
NODE_ENV=development
PORT=3016
SERVICE_NAME=time-tracking-service

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/boardpilot_time_tracking

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT
JWT_ACCESS_SECRET=your-jwt-access-secret-here-must-be-at-least-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-must-be-at-least-32-chars

# Encryption
ENCRYPTION_KEY=12345678901234567890123456789012

# Logging
LOG_LEVEL=info
