{
  "name": "@boardpilot/project-service",
  "version": "1.0.0",
  "description": "Project Service microservice for BoardPilot AI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:seed": "ts-node prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@boardpilot/common": "file:../../shared/packages/common",
    "@boardpilot/errors": "file:../../shared/packages/errors",
    "@boardpilot/events": "file:../../shared/packages/events",
    "@boardpilot/logger": "file:../../shared/packages/logger",
    "@boardpilot/middlewares": "file:../../shared/packages/middlewares",
    "@boardpilot/types": "file:../../shared/packages/types",
    "@prisma/client": "^5.10.2",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "uuid": "^9.0.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.30",
    "@types/uuid": "^9.0.8",
    "jest": "^29.7.0",
    "prisma": "^5.10.2",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.4.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "testMatch": ["**/*.test.ts"],
    "moduleNameMapper": {
      "@boardpilot/types": "<rootDir>/../../shared/packages/types/src",
      "@boardpilot/errors": "<rootDir>/../../shared/packages/errors/src",
      "@boardpilot/common": "<rootDir>/../../shared/packages/common/src",
      "@boardpilot/logger": "<rootDir>/../../shared/packages/logger/src",
      "@boardpilot/middlewares": "<rootDir>/../../shared/packages/middlewares/src",
      "@boardpilot/events": "<rootDir>/../../shared/packages/events/src"
    },
    "collectCoverageFrom": ["src/**/*.ts", "!src/index.ts"],
    "coverageDirectory": "coverage"
  }
}
