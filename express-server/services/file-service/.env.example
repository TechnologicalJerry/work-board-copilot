NODE_ENV=development
PORT=3014
SERVICE_NAME=file-service
LOG_LEVEL=info

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/boardpilot_files

# JWT
JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars-here

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_URL=amqp://localhost:5672

# AWS S3
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=boardpilot-files

# File settings
MAX_FILE_SIZE_MB=100

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption
ENCRYPTION_KEY=your-32-character-encryption-key!!
