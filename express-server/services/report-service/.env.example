NODE_ENV=development
PORT=3015
SERVICE_NAME=report-service
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres:password@localhost:5432/boardpilot_reports

JWT_ACCESS_SECRET=your-jwt-access-secret-min-32-chars-here
JWT_REFRESH_SECRET=your-jwt-refresh-secret-min-32-chars-here

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_URL=amqp://localhost:5672

TASK_SERVICE_URL=http://localhost:3002
SPRINT_SERVICE_URL=http://localhost:3005
PROJECT_SERVICE_URL=http://localhost:3003

ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
ENCRYPTION_KEY=your-32-character-encryption-key!!
