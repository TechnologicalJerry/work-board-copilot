generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma-client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model SavedReport {
  id             String     @id @default(uuid())
  organizationId String
  projectId      String?
  name           String
  type           ReportType
  config         Json
  isShared       Boolean    @default(false)
  createdBy      String
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  @@index([organizationId])
  @@index([projectId])
}

enum ReportType {
  BURNDOWN
  BURNUP
  VELOCITY
  CUMULATIVE_FLOW
  CYCLE_TIME
  LEAD_TIME
  WORKLOAD
  PRODUCTIVITY
  CUSTOM
}
