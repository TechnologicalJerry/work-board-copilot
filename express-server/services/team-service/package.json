{
  "name": "@boardpilot/team-service",
  "version": "1.0.0",
  "description": "Team management microservice for BoardPilot AI",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate deploy",
    "prisma:seed": "ts-node prisma/seed.ts",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@boardpilot/common": "file:../../shared/packages/common",
    "@boardpilot/config": "file:../../shared/packages/config",
    "@boardpilot/errors": "file:../../shared/packages/errors",
    "@boardpilot/events": "file:../../shared/packages/events",
    "@boardpilot/logger": "file:../../shared/packages/logger",
    "@boardpilot/middlewares": "file:../../shared/packages/middlewares",
    "@boardpilot/types": "file:../../shared/packages/types",
    "@boardpilot/validation": "file:../../shared/packages/validation",
    "@prisma/client": "^5.8.1",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.1",
    "yamljs": "^0.3.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "@types/yamljs": "^0.2.34",
    "jest": "^29.7.0",
    "prisma": "^5.8.1",
    "supertest": "^6.3.4",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": ["<rootDir>/tests"],
    "testMatch": ["**/*.test.ts"],
    "moduleNameMapper": {
      "@boardpilot/common": "<rootDir>/../../shared/packages/common/src/index.ts",
      "@boardpilot/errors": "<rootDir>/../../shared/packages/errors/src/index.ts",
      "@boardpilot/types": "<rootDir>/../../shared/packages/types/src/index.ts",
      "@boardpilot/logger": "<rootDir>/../../shared/packages/logger/src/index.ts",
      "@boardpilot/events": "<rootDir>/../../shared/packages/events/src/index.ts"
    },
    "collectCoverageFrom": ["src/**/*.ts", "!src/index.ts"]
  }
}
