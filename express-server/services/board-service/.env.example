NODE_ENV=development
PORT=3008
SERVICE_NAME=board-service

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/board_db

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_TTL=300

# RabbitMQ
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# JWT
JWT_ACCESS_SECRET=your-32-char-secret-here-minimum-32chars
JWT_REFRESH_SECRET=your-32-char-refresh-secret-here-32chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS
ALLOWED_ORIGINS=http://localhost:3000

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption
ENCRYPTION_KEY=your-exactly-32-char-encryption!!
