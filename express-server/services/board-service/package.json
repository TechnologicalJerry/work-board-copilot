{
  "name": "@boardpilot/board-service",
  "version": "1.0.0",
  "description": "Board Service for BoardPilot AI — manages Kanban/Scrum boards, columns, swimlanes, and filters",
  "private": true,
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "start": "node dist/server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --coverage --runInBand",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist",
    "migrate": "prisma migrate deploy",
    "migrate:dev": "prisma migrate dev",
    "generate": "prisma generate",
    "prisma:studio": "prisma studio"
  },
  "dependencies": {
    "@boardpilot/common": "file:../../shared/packages/common",
    "@boardpilot/config": "file:../../shared/packages/config",
    "@boardpilot/errors": "file:../../shared/packages/errors",
    "@boardpilot/events": "file:../../shared/packages/events",
    "@boardpilot/logger": "file:../../shared/packages/logger",
    "@boardpilot/middlewares": "file:../../shared/packages/middlewares",
    "@boardpilot/types": "file:../../shared/packages/types",
    "@boardpilot/validation": "file:../../shared/packages/validation",
    "@prisma/client": "^5.8.1",
    "amqplib": "^0.10.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "js-yaml": "^4.1.0",
    "jsonwebtoken": "^9.0.2",
    "prom-client": "^15.1.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/amqplib": "^0.10.4",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/js-yaml": "^4.0.9",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.11.0",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "prisma": "^5.8.1",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
