NODE_ENV=development
PORT=3003
SERVICE_NAME=organization-service
DATABASE_URL=postgresql://postgres:password@localhost:5432/boardpilot_orgs
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
RABBITMQ_URL=amqp://guest:guest@localhost:5672
JWT_ACCESS_SECRET=your-jwt-access-secret-here-must-be-at-least-32-chars
JWT_REFRESH_SECRET=your-jwt-refresh-secret-here-must-be-at-least-32-chars
ENCRYPTION_KEY=your-32-char-encryption-key-here
CORS_ORIGINS=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
INVITATION_EXPIRY_HOURS=72
LOG_LEVEL=info
