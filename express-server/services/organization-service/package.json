{
  "name": "@boardpilot/organization-service",
  "version": "1.0.0",
  "description": "BoardPilot Organization Service",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "lint": "eslint src --ext .ts",
    "test": "jest --passWithNoTests",
    "test:unit": "jest tests/unit --passWithNoTests",
    "test:integration": "jest tests/integration --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@boardpilot/common": "file:../../shared/packages/common",
    "@boardpilot/config": "file:../../shared/packages/config",
    "@boardpilot/errors": "file:../../shared/packages/errors",
    "@boardpilot/events": "file:../../shared/packages/events",
    "@boardpilot/logger": "file:../../shared/packages/logger",
    "@boardpilot/middlewares": "file:../../shared/packages/middlewares",
    "@boardpilot/types": "file:../../shared/packages/types",
    "@boardpilot/validation": "file:../../shared/packages/validation",
    "@prisma/client": "^5.10.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "uuid": "^9.0.0",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.11.0",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "prisma": "^5.10.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
