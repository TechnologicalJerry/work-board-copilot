{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "lib": ["ES2022"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "paths": {
      "@boardpilot/common": ["../../shared/packages/common/src"],
      "@boardpilot/config": ["../../shared/packages/config/src"],
      "@boardpilot/errors": ["../../shared/packages/errors/src"],
      "@boardpilot/events": ["../../shared/packages/events/src"],
      "@boardpilot/logger": ["../../shared/packages/logger/src"],
      "@boardpilot/middlewares": ["../../shared/packages/middlewares/src"],
      "@boardpilot/types": ["../../shared/packages/types/src"],
      "@boardpilot/validation": ["../../shared/packages/validation/src"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "tests"]
}
