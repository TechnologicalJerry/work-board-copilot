{
  "name": "@boardpilot/ai-service",
  "version": "1.0.0",
  "description": "BoardPilot AI Service - OpenAI integration for sprint planning, task breakdown, standups and more",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "start": "node dist/index.js",
    "test": "jest --coverage",
    "test:unit": "jest --testPathPattern=tests/unit --coverage",
    "test:integration": "jest --testPathPattern=tests/integration",
    "lint": "eslint src --ext .ts",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@boardpilot/common": "*",
    "@boardpilot/config": "*",
    "@boardpilot/errors": "*",
    "@boardpilot/events": "*",
    "@boardpilot/logger": "*",
    "@boardpilot/middlewares": "*",
    "@boardpilot/types": "*",
    "@boardpilot/validation": "*",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "eventsource": "^2.0.2",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "mongoose": "^8.1.1",
    "openai": "^4.28.0",
    "swagger-ui-express": "^5.0.0",
    "uuid": "^9.0.0",
    "yaml": "^2.3.4",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.11",
    "@types/node": "^20.11.0",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/uuid": "^9.0.7",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
