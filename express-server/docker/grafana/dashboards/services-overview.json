        { "datasource": { "type": "prometheus", "uid": "prometheus" }, "expr": "histogram_quantile(0.95, sum(rate(http_request_duration_seconds_bucket{job=~\"boardpilot-.*\"}[5m])) by (job, le))", "legendFormat": "{{job}}" }
      ]
    },
