# ============================================================
# BoardPilot AI - Environment Configuration
# ============================================================

# Node Environment
NODE_ENV=development

# ============================================================
# PostgreSQL
# ============================================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=boardpilot
POSTGRES_PASSWORD=boardpilot_secret
POSTGRES_DB=boardpilot

# ============================================================
# MongoDB
# ============================================================
MONGODB_URI=mongodb://boardpilot:boardpilot_secret@localhost:27017/boardpilot?authSource=admin

# ============================================================
# Redis
# ============================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=boardpilot_redis_secret

# ============================================================
# Elasticsearch
# ============================================================
ELASTICSEARCH_NODE=http://localhost:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=boardpilot_elastic_secret

# ============================================================
# RabbitMQ
# ============================================================
RABBITMQ_URL=amqp://boardpilot:boardpilot_secret@localhost:5672

# ============================================================
# JWT
# ============================================================
JWT_ACCESS_SECRET=your-256-bit-access-secret-change-in-production
JWT_REFRESH_SECRET=your-256-bit-refresh-secret-change-in-production
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ============================================================
# AWS S3
# ============================================================
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=boardpilot-files

# ============================================================
# Email (SMTP)
# ============================================================
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=your-sendgrid-api-key
EMAIL_FROM=noreply@boardpilot.ai

# ============================================================
# OAuth2
# ============================================================
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret
MICROSOFT_CLIENT_ID=your-microsoft-client-id
MICROSOFT_CLIENT_SECRET=your-microsoft-client-secret

# ============================================================
# OpenAI
# ============================================================
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# ============================================================
# Stripe
# ============================================================
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-stripe-webhook-secret
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key

# ============================================================
# Twilio (SMS)
# ============================================================
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# ============================================================
# Service Ports
# ============================================================
API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
USER_SERVICE_PORT=3002
ORGANIZATION_SERVICE_PORT=3003
WORKSPACE_SERVICE_PORT=3004
TEAM_SERVICE_PORT=3005
PROJECT_SERVICE_PORT=3006
SPRINT_SERVICE_PORT=3007
BOARD_SERVICE_PORT=3008
TASK_SERVICE_PORT=3009
NOTIFICATION_SERVICE_PORT=3010
COMMENT_SERVICE_PORT=3011
DOCUMENT_SERVICE_PORT=3012
SEARCH_SERVICE_PORT=3013
FILE_SERVICE_PORT=3014
REPORT_SERVICE_PORT=3015
TIME_TRACKING_SERVICE_PORT=3016
AUTOMATION_SERVICE_PORT=3017
AI_SERVICE_PORT=3018
AUDIT_SERVICE_PORT=3019
BILLING_SERVICE_PORT=3020

# ============================================================
# Monitoring
# ============================================================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3100
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=boardpilot-ai

# ============================================================
# CORS
# ============================================================
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ============================================================
# Rate Limiting
# ============================================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ============================================================
# Encryption
# ============================================================
ENCRYPTION_KEY=32-char-encryption-key-change-me!
